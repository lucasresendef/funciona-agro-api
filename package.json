{
  "name": "funciona-agro-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for farm and field supply management.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "format": "prettier --write .",
    "infra:up": "docker compose up -d funciona-agro-api-postgres funciona-agro-api-keycloak",
    "infra:down": "docker compose stop funciona-agro-api-keycloak funciona-agro-api-postgres",
    "infra:logs": "docker compose logs -f funciona-agro-api-postgres funciona-agro-api-keycloak",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx src/scripts/seed.ts",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.18.0",
    "dotenv": "^17.4.1",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.1",
    "prisma": "^6.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
