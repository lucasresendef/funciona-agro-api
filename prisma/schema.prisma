generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  ENTRY
  OUTBOUND_TO_FIELD
  RETURN_FROM_FIELD
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum FieldOperationStatus {
  OPEN
  FINISHED
  CANCELED
}

enum FarmUserRole {
  OWNER
  MANAGER
  OPERATOR
  VIEWER
}

model Tenant {
  id              String               @id @default(uuid()) @db.Uuid
  key             String               @unique
  name            String
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  users           AppUser[]
  farms           Farm[]
  farmPermissions FarmUserPermission[]
  products        Product[]

  @@map("tenant")
}

model AppUser {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  keycloakUserId  String?          @map("keycloak_user_id")
  name            String
  email           String
  isAdmin         Boolean          @default(false) @map("is_admin")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdBy       String?          @map("created_by")
  createdByEmail  String?          @map("created_by_email")
  updatedBy       String?          @map("updated_by")
  updatedByEmail  String?          @map("updated_by_email")
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fieldOperations FieldOperation[]     @relation("FieldOperationResponsibleUser")
  farmPermissions FarmUserPermission[]

  @@unique([tenantId, keycloakUserId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("app_user")
}

model Farm {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  name               String
  description        String?
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  createdBy          String?              @map("created_by")
  createdByEmail     String?              @map("created_by_email")
  updatedBy          String?              @map("updated_by")
  updatedByEmail     String?              @map("updated_by_email")
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fields             Field[]
  inventoryLocations InventoryLocation[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  fieldOperations    FieldOperation[]
  permissions        FarmUserPermission[]

  @@index([tenantId])
  @@map("farm")
}

model Field {
  id             String           @id @default(uuid()) @db.Uuid
  farmId         String           @map("farm_id") @db.Uuid
  name           String
  areaHectares   Decimal          @map("area_hectares") @db.Decimal(14, 4)
  description    String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  createdBy      String?          @map("created_by")
  createdByEmail String?          @map("created_by_email")
  updatedBy      String?          @map("updated_by")
  updatedByEmail String?          @map("updated_by_email")
  farm                  Farm                          @relation(fields: [farmId], references: [id], onDelete: Restrict)
  operationLinks        FieldOperationField[]
  itemConsumptionResults FieldOperationItemFieldResult[]

  @@index([farmId])
  @@map("field")
}

model UnitOfMeasure {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  symbol         String    @unique
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by")
  createdByEmail String?   @map("created_by_email")
  updatedBy      String?   @map("updated_by")
  updatedByEmail String?   @map("updated_by_email")
  products       Product[]

  @@map("unit_of_measure")
}

model Product {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  name              String
  code              String
  category          String
  description       String?
  activeIngredient  String?              @map("active_ingredient")
  unitOfMeasureId   String               @map("unit_of_measure_id") @db.Uuid
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  createdBy         String?              @map("created_by")
  createdByEmail    String?              @map("created_by_email")
  updatedBy         String?              @map("updated_by")
  updatedByEmail    String?              @map("updated_by_email")
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unitOfMeasure     UnitOfMeasure        @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  fieldOperationItems FieldOperationItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([unitOfMeasureId])
  @@map("product")
}

model InventoryLocation {
  id               String             @id @default(uuid()) @db.Uuid
  farmId           String             @map("farm_id") @db.Uuid
  name             String
  description      String?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  createdBy        String?            @map("created_by")
  createdByEmail   String?            @map("created_by_email")
  updatedBy        String?            @map("updated_by")
  updatedByEmail   String?            @map("updated_by_email")
  farm             Farm               @relation(fields: [farmId], references: [id], onDelete: Restrict)
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  fieldOperations   FieldOperation[]

  @@unique([farmId, name])
  @@index([farmId])
  @@map("inventory_location")
}

model InventoryBalance {
  id                  String            @id @default(uuid()) @db.Uuid
  farmId              String            @map("farm_id") @db.Uuid
  inventoryLocationId String            @map("inventory_location_id") @db.Uuid
  productId           String            @map("product_id") @db.Uuid
  quantity            Decimal           @db.Decimal(18, 6)
  averageUnitCost     Decimal           @map("average_unit_cost") @db.Decimal(18, 6)
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  createdBy           String?           @map("created_by")
  createdByEmail      String?           @map("created_by_email")
  updatedBy           String?           @map("updated_by")
  updatedByEmail      String?           @map("updated_by_email")
  farm                Farm              @relation(fields: [farmId], references: [id], onDelete: Restrict)
  inventoryLocation   InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([inventoryLocationId, productId])
  @@index([farmId])
  @@index([productId])
  @@map("inventory_balance")
}

model InventoryMovement {
  id                  String         @id @default(uuid()) @db.Uuid
  farmId              String         @map("farm_id") @db.Uuid
  inventoryLocationId String         @map("inventory_location_id") @db.Uuid
  productId           String         @map("product_id") @db.Uuid
  movementType        MovementType   @map("movement_type")
  quantity            Decimal        @db.Decimal(18, 6)
  unitCost            Decimal        @map("unit_cost") @db.Decimal(18, 6)
  totalCost           Decimal        @map("total_cost") @db.Decimal(18, 6)
  occurredAt          DateTime       @map("occurred_at")
  referenceType       String?        @map("reference_type")
  referenceId         String?        @map("reference_id")
  notes               String?
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  createdBy           String?        @map("created_by")
  createdByEmail      String?        @map("created_by_email")
  updatedBy           String?        @map("updated_by")
  updatedByEmail      String?        @map("updated_by_email")
  farm                Farm           @relation(fields: [farmId], references: [id], onDelete: Restrict)
  inventoryLocation   InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([farmId, occurredAt])
  @@index([referenceType, referenceId])
  @@index([productId])
  @@map("inventory_movement")
}

model FieldOperation {
  id                String               @id @default(uuid()) @db.Uuid
  sequenceNumber    Int                  @default(autoincrement()) @map("sequence_number")
  farmId            String               @map("farm_id") @db.Uuid
  inventoryLocationId String?            @map("inventory_location_id") @db.Uuid
  operationDate     DateTime             @map("operation_date")
  status            FieldOperationStatus @default(OPEN)
  description       String?
  responsibleUserId String?              @map("responsible_user_id") @db.Uuid
  startedAt         DateTime?            @map("started_at")
  finishedAt        DateTime?            @map("finished_at")
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  createdBy         String?              @map("created_by")
  createdByEmail    String?              @map("created_by_email")
  updatedBy         String?              @map("updated_by")
  updatedByEmail    String?              @map("updated_by_email")
  farm              Farm                 @relation(fields: [farmId], references: [id], onDelete: Restrict)
  inventoryLocation InventoryLocation?   @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  responsibleUser   AppUser?             @relation("FieldOperationResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  items             FieldOperationItem[]
  fields            FieldOperationField[]

  @@index([farmId, operationDate])
  @@unique([sequenceNumber])
  @@index([inventoryLocationId])
  @@index([responsibleUserId])
  @@map("field_operation")
}

model FieldOperationItem {
  id                  String         @id @default(uuid()) @db.Uuid
  fieldOperationId    String         @map("field_operation_id") @db.Uuid
  productId           String         @map("product_id") @db.Uuid
  quantitySent        Decimal        @map("quantity_sent") @db.Decimal(18, 6)
  quantityReturned    Decimal        @default(0) @map("quantity_returned") @db.Decimal(18, 6)
  quantityConsumed    Decimal        @map("quantity_consumed") @db.Decimal(18, 6)
  unitCostAtOperation Decimal        @map("unit_cost_at_operation") @db.Decimal(18, 6)
  totalCostConsumed   Decimal        @map("total_cost_consumed") @db.Decimal(18, 6)
  notes               String?
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  createdBy           String?        @map("created_by")
  createdByEmail      String?        @map("created_by_email")
  updatedBy           String?        @map("updated_by")
  updatedByEmail      String?        @map("updated_by_email")
  fieldOperation      FieldOperation @relation(fields: [fieldOperationId], references: [id], onDelete: Cascade)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  fieldResults        FieldOperationItemFieldResult[]

  @@index([fieldOperationId])
  @@index([productId])
  @@map("field_operation_item")
}

model FieldOperationField {
  id                String         @id @default(uuid()) @db.Uuid
  fieldOperationId  String         @map("field_operation_id") @db.Uuid
  fieldId           String         @map("field_id") @db.Uuid
  areaHectaresSnapshot Decimal     @map("area_hectares_snapshot") @db.Decimal(14, 4)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  createdBy         String?        @map("created_by")
  createdByEmail    String?        @map("created_by_email")
  updatedBy         String?        @map("updated_by")
  updatedByEmail    String?        @map("updated_by_email")
  fieldOperation    FieldOperation @relation(fields: [fieldOperationId], references: [id], onDelete: Cascade)
  field             Field          @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([fieldOperationId, fieldId])
  @@index([fieldOperationId])
  @@index([fieldId])
  @@map("field_operation_field")
}

model FieldOperationItemFieldResult {
  id                          String             @id @default(uuid()) @db.Uuid
  fieldOperationItemId        String             @map("field_operation_item_id") @db.Uuid
  fieldId                     String             @map("field_id") @db.Uuid
  allocatedQuantityConsumed   Decimal            @map("allocated_quantity_consumed") @db.Decimal(18, 6)
  allocatedTotalCostConsumed  Decimal            @map("allocated_total_cost_consumed") @db.Decimal(18, 6)
  active                      Boolean            @default(true)
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")
  createdBy                   String?            @map("created_by")
  createdByEmail              String?            @map("created_by_email")
  updatedBy                   String?            @map("updated_by")
  updatedByEmail              String?            @map("updated_by_email")
  fieldOperationItem          FieldOperationItem @relation(fields: [fieldOperationItemId], references: [id], onDelete: Cascade)
  field                       Field              @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([fieldOperationItemId, fieldId])
  @@index([fieldOperationItemId])
  @@index([fieldId])
  @@map("field_operation_item_field_result")
}

model FarmUserPermission {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  farmId         String       @map("farm_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           FarmUserRole
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @map("created_by")
  createdByEmail String?      @map("created_by_email")
  updatedBy      String?      @map("updated_by")
  updatedByEmail String?      @map("updated_by_email")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm           Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user           AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("farm_user_permission")
}
